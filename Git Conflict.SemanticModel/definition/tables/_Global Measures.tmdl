			VAR _Header = "Product sales"
			VAR _Subtitle = "Which products and brands generate the most sales?"
			RETURN
			Custom_Header_Ranking(
			    _Header, --Header
			    _Subtitle, --Subtitle
			    "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21.21 15.89A10 10 0 1 1 8 2.83'></path><path d='M22 12A10 10 0 0 0 12 2v10z'></path></svg>", --Icon PATH (Pie Chart)
			    "#006084", --Optional: Icon color (Granatowy)
			    "#E6EFF3", --Optional: Icon background (Jasnoniebieskie tło)
			    BLANK(), --Optional: Title color
			    BLANK() --Optional: Subtitle color
			)
		displayFolder: KPI Cards
		lineageTag: e255ce7d-d09e-4eb6-9220-9bc949645977

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simple KPI SVG' = ```
			
			VAR _attRaw = [Quota Attainment % (Assigned)]
			VAR _att = IF(ISBLANK(_attRaw), 0, _attRaw)
			VAR _textVal = ROUND(_att * 100, 1) & "%"
			RETURN
			"data:image/svg+xml;utf8," & 
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' width='100' height='100'>
			  <circle cx='50' cy='50' r='45' fill='#2E7D32' />
			  <text x='50' y='50' font-family='sans-serif' font-size='20' font-weight='bold' fill='#FFFFFF' text-anchor='middle' dominant-baseline='central'>" & _textVal & "</text>
			</svg>"
			```
		displayFolder: KPI Cards
		lineageTag: 4d6db244-5e44-4260-a908-bba12ed0fb04
		dataCategory: ImageUrl

		annotation PBI_FormatHint = {"isGeneralNumber":true}

