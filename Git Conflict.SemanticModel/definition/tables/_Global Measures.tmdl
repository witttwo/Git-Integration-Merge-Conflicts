table '_Global Measures'
	lineageTag: ebee8586-6453-421c-96b9-4a7c4b8c0652

	measure HTML_KPI_Card_Dynamic =
			
			-- ================= CONFIG (tune thresholds here) =================
			VAR _CvGood = 0.12      -- CV <= 12%  -> consistent
			VAR _CvOk   = 0.22      -- CV <= 22%  -> moderate
			VAR _Flat   = 0.02      -- +/-2% newer vs older half -> flat
			VAR _Strong = 0.10      -- >10% move  -> "sharply", else "trending"
			
			-- ===== WINDOW: last 6 FULL months up to TODAY (not end of data) =====
			VAR _Anchor = EOMONTH ( TODAY (), -1 )          -- last completed month end, e.g. Jun 30
			VAR _Start  = EOMONTH ( TODAY (), -7 ) + 1      -- first day 6 months earlier, e.g. Jan 1
			VAR _Monthly =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( DimDate[MonthYear] ),
			            "@MonthEnd", CALCULATE ( MAX ( DimDate[Date] ) ),
			            "@Val", [Sales AVG by PH]
			        ),
			        DimDate[Date] >= _Start,
			        DimDate[Date] <= _Anchor,
			        ALL ( DimDate )                          -- ignore the page date slicer
			    )
			VAR _Data   = FILTER ( _Monthly, [@Val] > 0 )
			VAR _Months = COUNTROWS ( _Data )
			VAR _Avg    = AVERAGEX ( _Data, [@Val] )
			VAR _StdDev = STDEVX.S ( _Data, [@Val] )
			VAR MetricValue = DIVIDE ( _StdDev, _Avg )       -- = [Sales KPI Deviation]
			
			-- ===== TREND: newer half vs older half of the window =====
			VAR _Recent3   = TOPN ( 3, _Data, [@MonthEnd], DESC )
			VAR _Prior     = EXCEPT ( _Data, _Recent3 )
			VAR _AvgRecent = AVERAGEX ( _Recent3, [@Val] )
			VAR _AvgPrior  = AVERAGEX ( _Prior, [@Val] )
			VAR _TrendPct  = DIVIDE ( _AvgRecent - _AvgPrior, _AvgPrior )
			
			-- ===== FLAGS =====
			VAR _Consistent = MetricValue <= _CvGood
			VAR _Moderate   = MetricValue <= _CvOk
			VAR _Rising     = _TrendPct >  _Flat
			VAR _Falling    = _TrendPct < -_Flat
			VAR _BigMove    = ABS ( _TrendPct ) > _Strong
			
			-- ===== MONTH LABELS ("MMM yy" if the window crosses a year) =====
			VAR _RecFrom = FORMAT ( MINX ( _Recent3, [@MonthEnd] ), "MMM", "en-US" )
			VAR _RecTo   = FORMAT ( MAXX ( _Recent3, [@MonthEnd] ), "MMM", "en-US" )
			VAR _PriFrom = FORMAT ( MINX ( _Prior,   [@MonthEnd] ), "MMM", "en-US" )
			VAR _PriTo   = FORMAT ( MAXX ( _Prior,   [@MonthEnd] ), "MMM", "en-US" )
			VAR _RecLbl  = IF ( _RecFrom = _RecTo, _RecFrom, _RecFrom & "–" & _RecTo )
			VAR _PriLbl  = IF ( _PriFrom = _PriTo, _PriFrom, _PriFrom & "–" & _PriTo )
			VAR _WinLbl  = IF ( ISBLANK ( _PriFrom ), _RecLbl, _PriFrom & "–" & _RecTo )
			
			-- ===== NARRATIVE: short natural sentences, calm -> drama (PL register) =====
			VAR MainTitle =
			    SWITCH ( TRUE (),
			        _Consistent && NOT ( _Falling ), "High sales consistency ✔",
			        _Consistent,                     "Consistent, but trending down",
			        _Moderate,                       "Moderate sales consistency",
			                                         "Volatile sales month to month"
			    )
			VAR _VarPart =
			    SWITCH ( TRUE (),
			        _Consistent, "Steady, predictable rhythm",
			        _Moderate,   "Some month-to-month swing",
			                     "Erratic month to month"
			    )
			VAR _TrendPhrase =
			    SWITCH ( TRUE (),
			        _Rising  && _BigMove, "now rising sharply <span class='up'>↗</span>",
			        _Rising,              "now trending up <span class='up'>↗</span>",
			        _Falling && _BigMove, "now falling sharply <span class='dn'>↘</span>",
			        _Falling,             "now trending down <span class='dn'>↘</span>",
			                              "and holding flat"
			    )
			VAR Subtitle =
			    IF (
			        ISBLANK ( _TrendPct ),
			        _VarPart & ".",
			        _VarPart & ", " & _TrendPhrase & " (" & _RecLbl & " vs " & _PriLbl & ")."
			    )
			
			VAR _SelName     = [Selected PH Name]
			VAR _RepSelected = NOT ISBLANK ( _SelName ) && _SelName <> "Whole team"
			VAR _PerRep = IF ( _RepSelected, "", " per rep" )
			VAR _AvgK   = FORMAT ( _Avg,    "$#,##0,", "en-US" ) & "K"
			VAR _StdK   = FORMAT ( _StdDev, "$#,##0,", "en-US" ) & "K"
			VAR FooterText =
			    "The last " & _Months & " months average is <span class='hl'>" & _AvgK & "</span>/mo" & _PerRep
			    & ", with a typical swing of <span class='hl'>±" & _StdK & "</span> (1σ)."
			
			VAR MetricColor =
			    SWITCH ( TRUE (),
			        _Consistent, "#006084",
			        _Moderate,   "#c77700",
			                     "#d93025"
			    )
			
			VAR BadgeText = [Selected PH Name]
			VAR _ID =
			    "kpi_"
			        & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( BadgeText, " ", "" ), ".", "" ), "'", "" )
			
			-- ===== OVERLAY (300s layer: definition + exact numbers) =====
			VAR ExplanationHeader = "COEFFICIENT OF VARIATION (CV)"
			VAR ExplanationDesc =
			    "Stability of monthly Net Sales over the last 6 months for the selected rep or the whole team. Standard deviation divided by the mean — the closer to 0%, the more consistent the workload."
			VAR WindowHeader = "THIS " & _Months & "-MONTH WINDOW"
			VAR _TrendTxt = FORMAT ( ABS ( _TrendPct ), "0.0%", "en-US" )
			VAR WindowDesc =
			    _WinLbl & ": monthly sales" & _PerRep
			    & " averaged " & FORMAT ( _Avg, "$#,##0", "en-US" )
			    & ", with a typical month-to-month swing of ±" & FORMAT ( _StdDev, "$#,##0", "en-US" )
			    & " (1σ)."
			    & IF (
			        ISBLANK ( _TrendPct ),
			        "",
			        " Recent months (" & _RecLbl & ") ran "
			            & IF ( _TrendPct >= 0, "+", "-" ) & _TrendTxt & " vs " & _PriLbl & "."
			    )
			
			VAR HtmlString =
			"<!DOCTYPE html>
			<html style='margin:0; padding:0; overflow:hidden;'>
			<head>
			<style>
			    html, body { margin:0; padding:0; height:100%; width:100%; overflow:hidden; background-color:transparent; }
			    .main-wrapper { position:relative; width:100%; height:100%; padding:3vw; box-sizing:border-box; font-family:'Montserrat', Tahoma, Geneva, Verdana, sans-serif; overflow:hidden; }
			    .badge { background-color:#006084; color:white; padding:1vw 2.5vw; border-radius:4vw; font-size:3vw; font-weight:700; display:inline-block; margin-bottom:2vw; }
			    .title { font-size:4.5vw; font-weight:700; color:#1a1a1a; margin-bottom:1.5vw; }
			    .metric-container { margin-bottom:2vw; }
			    .metric-value { font-size:4vw; font-weight:700; color:" & MetricColor & "; cursor:pointer; display:inline-block; position:relative; z-index:5; }
			    .cvtag { font-size:2vw; font-weight:700; color:#9aa0aa; margin-left:0.6vw; margin-right:1vw; letter-spacing:0.5px; }
			    .metric-subtitle { font-size:3.2vw; color:#555555; font-weight:400; }
			    .footer { font-size:2.8vw; color:#555555; font-weight:400; }
			    .hl { color:#006084; font-weight:700; }
			    .up { color:#188038; font-weight:700; }
			    .dn { color:#d93025; font-weight:700; }
			    .overlay { position:absolute; top:0; left:0; width:100%; height:100%; background:#006084; color:#FFFFFF; padding:4vw 5vw; box-sizing:border-box; display:flex; flex-direction:column; justify-content:center; transform:translateY(110%); visibility:hidden; transition:transform 0.35s cubic-bezier(0.16,1,0.3,1), visibility 0.35s; z-index:10; border-radius:4vw; text-align:left; }
			    .metric-value:hover ~ .overlay, .overlay:hover { transform:translateY(0); visibility:visible; }
			    .ov-block { margin-bottom:2.2vw; }
			    .ov-block:last-child { margin-bottom:0; }
			    .ov-header { font-size:2.2vw; font-weight:700; opacity:0.5; margin-bottom:1vw; letter-spacing:1px; text-transform:uppercase; }
			    .ov-desc { font-size:2.6vw; line-height:1.4; font-weight:400; }
			</style>
			</head>
			<body>
			    <div class='main-wrapper'>
			        <div class='badge'>" & BadgeText & "</div>
			        <div class='title'>" & MainTitle & "</div>
			        <div class='metric-container'>
			            <span class='metric-value' id='count-" & _ID & "'>0.0%</span><span class='cvtag'>CV</span>
			            <div class='overlay'>
			                <div class='ov-block'>
			                    <div class='ov-header'>" & ExplanationHeader & "</div>
			                    <div class='ov-desc'>" & ExplanationDesc & "</div>
			                </div>
			                <div class='ov-block'>
			                    <div class='ov-header'>" & WindowHeader & "</div>
			                    <div class='ov-desc'>" & WindowDesc & "</div>
			                </div>
			            </div>
			            <span class='metric-subtitle'>" & Subtitle & "</span>
			        </div>
			        <div class='footer'>" & FooterText & "</div>
			    </div>
			
			    <script>
			        (function() {
			            const target = parseFloat('" & FORMAT ( MetricValue, "0.0000", "en-US" ) & "');
			            const element = document.getElementById('count-" & _ID & "');
			            const duration = 1500;
			            const start = performance.now();
			
			            function update(now) {
			                const elapsed = now - start;
			                const progress = Math.min(elapsed / duration, 1);
			                const ease = 1 - Math.pow(1 - progress, 3);
			                const current = target * ease * 100;
			                element.textContent = current.toFixed(1) + '%';
			                if (progress < 1) { requestAnimationFrame(update); }
			            }
			            requestAnimationFrame(update);
			        })();
			    </script>
			</body>
			</html>"
			
			RETURN
			    IF ( _Months <= 1 || ISBLANK ( _Avg ) || _Avg = 0, BLANK (), HtmlString )
		displayFolder: Kilometrówka
		lineageTag: facd5e16-bf71-45e0-b40e-32f7ed6a70b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected PH Name' =
			
			SWITCH(
			    TRUE(),
			    HASONEVALUE(DimRep[RepName]) && ISFILTERED(DimRep[RepName]), SELECTEDVALUE(DimRep[RepName]),
			    ISFILTERED(DimRep[RepName]), "Selected people",
			    "Whole team"
			)
		displayFolder: Kilometrówka
		lineageTag: db0f6adb-a89d-4372-936a-d38ff34097cc

	measure 'Visits KPI Dashboard Footer' =
			VAR _Sales   = [Net Sales]
			    VAR _MaxDate = CALCULATE(MAX(DimDate[Date]),
			                    ALL(FactSales),ALL(DimDate),ALL(DimDealer),ALL(DimSku),ALL(DimRep))
			    VAR _Period  = DATESINPERIOD(DimDate[Date], _MaxDate, -6, MONTH)
			
			    VAR _MonthlyData =
			        CALCULATETABLE(
			            ADDCOLUMNS(
			                VALUES(DimDate[MonthYear]),
			                "@Avg", CALCULATE([Sales AVG by PH])
			            ),
			            _Period
			        )
			    VAR _FilteredData = FILTER(_MonthlyData, [@Avg] > 0)
			    VAR _MonthsCount  = COUNTROWS(_FilteredData)
			    VAR _Mean         = AVERAGEX(_FilteredData, [@Avg])
			    VAR _SumSqDiff    = SUMX(_FilteredData, POWER([@Avg] - _Mean, 2))
			    VAR _Odchylenie   = SQRT(DIVIDE(_SumSqDiff, _MonthsCount - 1))
			    VAR _Srednia      = FORMAT(_Mean,       "$#,0")
			    VAR _OdchStr      = FORMAT(_Odchylenie, "$#,0")
			    VAR _OkresTekst   = IF(_MonthsCount >= 6, "6 miesięcy", _MonthsCount & " m-cy")
			    VAR _CzyJedenRep  = HASONEVALUE(DimRep[RepName]) && ISFILTERED(DimRep[RepName])
			    VAR _TekstJedn    = IF(_CzyJedenRep, " (odchylenie o ", "/rep (odchylenie o ")
			
			    RETURN
			    IF(
			        NOT(ISBLANK(_Sales)) && _MonthsCount > 1,
			        "Z ostatnich " & _OkresTekst & ": średnio " & _Srednia & _TekstJedn & _OdchStr & ")"
			    )
		lineageTag: 8a4f43a5-4638-4648-a303-021832d0dae4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales KPI Deviation' = Deviation_6_Months ( [Net Sales], [Sales AVG by PH] )
