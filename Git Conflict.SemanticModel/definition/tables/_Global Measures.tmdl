		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI Card Net Sales IMG' =
			
			VAR _curr     = [Net Sales]
			VAR _prev     = CALCULATE([Net Sales], SAMEPERIODLASTYEAR(DimDate[Date]))
			VAR _hasPY    = NOT ISBLANK(_prev) && _prev <> 0
			VAR _yoy      = DIVIDE(_curr - _prev, ABS(_prev))
			VAR _yoyArrow = IF(_yoy >= 0, "▲ +", "▼ ")
			VAR _sub1Val  = IF(_hasPY, _yoyArrow & FORMAT(ABS(_yoy) * 100, "0.0", "en-US") & "%", "—")
			VAR _sub1Clr  = IF(_yoy >= 0, "#b1e0b5", "#d0f7e0")
			VAR _repData  = ADDCOLUMNS(FILTER(ALL(DimRep), DimRep[RepKey] <> -1), "@s", CALCULATE([Net Sales]))
			VAR _top1     = TOPN(1, _repData, [@s], DESC)
			VAR _repName  = MAXX(_top1, DimRep[RepName])
			VAR _repSales = MAXX(_top1, [@s])
			VAR _sub2Val  = IF(NOT ISBLANK(_repName), _repName & " (" & FORMAT(_repSales, "$#,0", "en-US") & ")", "—")
			RETURN
			    KPI_SVG_TwoSubs(
			        "Net Sales",
			        _curr,
			        "$",
			        "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6",
			        "#006084",
			        "#FFFFFF",
			        "#FFFFFF",
			        "#c8e8f7",
			        "#c8e8f7",
			        "vs Prior Year",
			        _sub1Val,
			        _sub1Clr,
			        "Top rep:",
			        _sub2Val,
			        "#c8e8f7",
			        "#004b69"
			    )
		formatString: General
		displayFolder: KPI Cards
		lineageTag: 1a2b3c4d-5e6f-7890-abcd-111111111111
		dataCategory: ImageUrl

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI Card Orders IMG' =
			
			VAR _curr     = [# Orders]
			VAR _prev     = CALCULATE([# Orders], SAMEPERIODLASTYEAR(DimDate[Date]))
			VAR _hasPY    = NOT ISBLANK(_prev) && _prev <> 0
			VAR _yoy      = DIVIDE(_curr - _prev, ABS(_prev))
			VAR _yoyArrow = IF(_yoy >= 0, "▲ +", "▼ ")
			VAR _sub1Val  = IF(_hasPY, _yoyArrow & FORMAT(ABS(_yoy) * 100, "0.0") & "%", "—")
			VAR _sub1Clr  = IF(_yoy >= 0, "#10b981", "#d93025")
			VAR _dealData = ADDCOLUMNS(ALL(DimDealer), "@o", CALCULATE([# Orders]))
			VAR _top1     = TOPN(1, FILTER(_dealData, [@o] > 0), [@o], DESC)
			VAR _dName    = MAXX(_top1, DimDealer[DealerName])
			VAR _dOrd     = MAXX(_top1, [@o])
			VAR _sub2Val  = IF(NOT ISBLANK(_dName), _dName & " (" & FORMAT(_dOrd, "#,0") & " ord.)", "—")
			RETURN
			    KPI_SVG_TwoSubs(
			        "Orders",
			        _curr,
			        "orders",
			        "M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0",
			        "#FFFFFF",
			        "#0A1E41",
			        "#5F6B7C",
			        "#005A8C",
			        "#D0E3F0",
			        "vs Prior Year",
			        _sub1Val,
			        _sub1Clr,
			        "Top dealer:",
			        _sub2Val,
			        "#005A8C",
			        BLANK()
			    )
		formatString: General
		displayFolder: KPI Cards
		lineageTag: 2b3c4d5e-6f70-8901-bcde-222222222222
		dataCategory: ImageUrl

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI Card Quota IMG' = ```
			
			VAR _attRaw   = [Quota Attainment % (Assigned)]
			VAR _att      = IF(ISBLANK(_attRaw), 0, _attRaw)
			VAR _vsq      = [Net Sales vs Quota]
			VAR _absVsq   = ABS(_vsq)
			VAR _vsqArrow = IF(_vsq >= 0, "▲ +", "▼ ")
			VAR _vsqText  = IF(_vsq >= 0, " above quota", " below quota")
			VAR _fmtAmt   = 
			    SWITCH(TRUE(),
			        _absVsq >= 1000000, FORMAT(_absVsq / 1000000, "$0.0\M", "en-US"),
			        _absVsq >= 1000, FORMAT(_absVsq / 1000, "$0.0\K", "en-US"),
			        FORMAT(_absVsq, "$0", "en-US")
			    )
			VAR _sub1Val  = IF(NOT ISBLANK(_vsq), _vsqArrow & _fmtAmt & _vsqText, "—")
			VAR _sub1Clr  = IF(_vsq >= 0, "#10b981", "#d93025")
			VAR _reps     = FILTER(ALL(DimRep), DimRep[RepKey] <> -1)
			VAR _repAtt   = ADDCOLUMNS(_reps, "@a", CALCULATE([Quota Attainment %]))
			VAR _top1     = TOPN(1, FILTER(_repAtt, NOT ISBLANK([@a])), [@a], DESC)
			VAR _repName  = MAXX(_top1, DimRep[RepName])
			VAR _repAttV  = MAXX(_top1, [@a])
			VAR _sub2Val  = IF(NOT ISBLANK(_repName), _repName & ": " & FORMAT(_repAttV * 100, "0.0", "en-US") & "%", "—")
			RETURN
			    KPI_SVG_TwoSubs(
			        "Quota Attainment",
			        ROUND(_att * 100, 1),
			        "%",
			        "m22 2-7 20-4-9-9-4 20-7z",
			        "#FFFFFF",
			        "#0A1E41",
			        "#5F6B7C",
			        "#005A8C",
			        "#D0E3F0",
			        "Net Sales vs Quota",
			        _sub1Val,
			        _sub1Clr,
			        "Top rep:",
			        _sub2Val,
			        "#005A8C",
			        BLANK()
			    )
			```
		formatString: General
		displayFolder: KPI Cards
		lineageTag: 3c4d5e6f-7081-9012-cdef-333333333333
		dataCategory: ImageUrl

