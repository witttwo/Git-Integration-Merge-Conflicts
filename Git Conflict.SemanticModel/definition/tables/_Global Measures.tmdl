	measure 'Visits KPI Dashboard Header' =
			
			VAR _CV     = [Sales KPI Deviation]
			VAR _Sales  = [Net Sales]
			VAR _IconGood    = "<svg style='margin-left:6px; flex-shrink:0; width:22px; height:22px; stroke:#10b981;' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke-width='2.5' 			stroke-linecap='round' stroke-linejoin='round'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><path d='m9 11 3 3L22 4'/></svg>"
			VAR _IconNeutral = "<svg style='margin-left:6px; flex-shrink:0; width:22px; height:22px; stroke:#94a3b8;' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke-width='2.5' 			stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><path d='M8 12h8'/></svg>"
			VAR _IconAlert   = "<svg style='margin-left:6px; flex-shrink:0; width:22px; height:22px; stroke:#f59e0b;' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke-width='2.5' 			stroke-linecap='round' stroke-linejoin='round'><path d='m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3'/><path d='M12 9v4'/><path d='M12 17h.01'/></svg>"
			VAR _TitleGood    = "<div style='display:flex; align-items:center;'>Wysoka regularność sprzedaży"    & _IconGood    & "</div>"
			VAR _TitleNeutral = "<div style='display:flex; align-items:center;'>Standardowa dynamika sprzedaży" & _IconNeutral & "</div>"
			VAR _TitleAlert   = "<div style='display:flex; align-items:center;'>Wysoka nieregularność sprzedaży" & _IconAlert  & "</div>"
			VAR _TitleBlank   = "<div style='display:flex; align-items:center;'>Brak danych o zmienności</div>"
			
			RETURN
			IF(
			    NOT(ISBLANK(_Sales)),
			    SWITCH(
			        TRUE(),
			        ISBLANK(_CV),   _TitleBlank,
			        _CV <= 0.20,    _TitleGood,
			        _CV <= 0.40,    _TitleNeutral,
			        _TitleAlert
			    )
			)
		lineageTag: e1808117-d4e5-49f6-aa57-b1280cd64d4d

	measure Trend_Wizyt_6M_Pct =
			
			   			-- Indeks sekwencyjny: sty 2024 = 1, lut 2024 = 2, ...
			   			VAR _AllMonths =
			   			    CALCULATETABLE(
			   			        ADDCOLUMNS(
			   			            VALUES(DimDate[MonthYear]),
			   			            "@SeqX", CALCULATE(MAXX(DimDate, (DimDate[Year] - 2024) * 12 + DimDate[Month]))
			   			        ),
			   			        REMOVEFILTERS(DimDate)
			   			    )
						   			-- Ostatni miesiąc z danymi
			   			VAR _MonthsWithData = FILTER(_AllMonths, CALCULATE([Net Sales]) > 0)
			   			VAR _AnchorMonth    = MAXX(_MonthsWithData, [@SeqX])
						   			-- Okno 6-miesięczne
			   			VAR _TrendTable =
			   			    CALCULATETABLE(
			   			        ADDCOLUMNS(
			   			            VALUES(DimDate[MonthYear]),
			   			            "@X", CALCULATE(MAXX(DimDate, (DimDate[Year] - 2024) * 12 + DimDate[Month])),
			   			            "@Y", [Net Sales]
			   			        ),
			   			        REMOVEFILTERS(DimDate),
			   			        FILTER(_AllMonths, [@SeqX] >= _AnchorMonth - 5 && [@SeqX] <= _AnchorMonth)
			   			    )
						   			VAR _TrendData = FILTER(_TrendTable, NOT(ISBLANK([@Y])) && [@Y] > 0)
			   			VAR _N         = COUNTROWS(_TrendData)
			   			VAR _SumX      = SUMX(_TrendData, [@X])
			   			VAR _SumY      = SUMX(_TrendData, [@Y])
			   			VAR _SumXY     = SUMX(_TrendData, [@X] * [@Y])
			   			VAR _SumX2     = SUMX(_TrendData, [@X] * [@X])
			   			VAR _AvgY      = DIVIDE(_SumY, _N)
			   			VAR _Slope     = DIVIDE(_N * _SumXY - _SumX * _SumY, _N * _SumX2 - _SumX * _SumX)
			   			VAR _SlopeNorm = DIVIDE(_Slope, _AvgY)
						   			RETURN
			   			IF(_N >= 4, _SlopeNorm, BLANK())
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Kilometrówka
		lineageTag: 4c3635a1-1d99-4e3c-8f32-2fd4b772e8ab

	measure 'Visits KPI Dashboard Subtitle' = ```
			
			VAR _CV = [Sales KPI Deviation]
			VAR _Wizyty = [Net Sales]
			VAR _Trend = [Trend_Wizyt_6M_Pct]
			VAR _CvDesc = 
			    SWITCH(
			        TRUE(),
			        ISBLANK(_CV), "Zbyt mały zakres pełnych m-cy do obliczeń",
			        _CV <= 0.20, "Zmienność w normie (stabilne obciążenie m/m)",
			        _CV <= 0.40, "Naturalna dynamika (umiarkowane odchylenia m/m)",
			        "Niestabilne tempo (praca 'zrywami' m/m)"
			    )
			VAR _TrendDesc = 
			    SWITCH(
			        TRUE(),
			        ISBLANK(_Trend), "",
			        _Trend >= 0.10, " i silny trend rosnący",
			        _Trend >= 0.05, " i wyraźny trend rosnący",
			        _Trend >= 0.02, " i łagodny trend rosnący",
			        _Trend <= -0.10, " oraz silny zjazd aktywności",
			        _Trend <= -0.05, " oraz wyraźny trend spadkowy",
			        _Trend <= -0.02, " oraz łagodny trend spadkowy",
			        " i stabilna aktywność"
			    )
			RETURN
			IF(
			    NOT(ISBLANK(_Wizyty)),
			    IF(
			        ISBLANK(_CV),
			        _CvDesc,
			        _CvDesc & _TrendDesc
			    )
			)
			```
		displayFolder: Kilometrówka
		lineageTag: f3dd515c-beab-4a6c-8bcc-8ecde87b2177

	measure 'KPI Card Product Cost Overall IMG' =
			
			// ── Sub1: zmiana vs poprzedni miesiąc ─────────────────────────────────────
			VAR _prev      = [Net Sales]
			VAR _momRaw    = [Net Sales PY]
			VAR _hasMoM    = NOT ISBLANK(_prev) && _prev <> 0
			VAR _momArrow  = IF(_momRaw >= 0, "▲ +", "▼ ")
			VAR _sub1Val   = IF(_hasMoM, _momArrow & FORMAT(ABS(_momRaw) * 100, "0.0") & "%", "—")
			VAR _sub1Color = IF(_momRaw >= 0, "#E74C3C", "#27AE60")
			
			// ── Sub2: produkt z największym wzrostem kosztu ────────────────────────────
			VAR _produkty  = VALUES(DimRep[RepName])
			VAR _zDiff     =
			    ADDCOLUMNS(
			        _produkty,
			        "@diff", CALCULATE([Net Sales vs Peer %]),
			        "@prev", CALCULATE([Net Sales vs Peer Text])
			    )
			VAR _top1      = TOPN(1, FILTER(_zDiff, [@diff] > 0), [@diff], DESC)
			VAR _topName   = MAXX(_top1, [Top Dealer Footer])
			VAR _topDiff   = MAXX(_top1, [@diff])
			VAR _topPrev   = MAXX(_top1, [@prev])
			VAR _topPct    = DIVIDE(_topDiff, ABS(_topPrev)) * 100
			VAR _sub2Val   =
			    IF(
			        NOT ISBLANK(_topName),
			        _topName & " (+" & FORMAT(_topPct, "0.0") & "%)",
			        "brak wzrostow"
			    )
			
			RETURN
			KPI_SVG_TwoSubs(
			    "Koszt total",                                                                          -- 1. _TitleTxt
			    [Net Sales],                                                                 -- 2. _ValueKPI
			    "zl",                                                                                   -- 3. _SuffixTxt
			    "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6",                        -- 4. _IconPathD
			    "#FFFFFF",          -- 5. background color
			    "#0A1E41",          -- 6. dark text (title, value)
			    "#5F6B7C",          -- 7. grey text (labels)
			    "#6A1B9A",                                                                              -- 8. _Accent
			    "#E5E7EB",                                                                              -- 9. _BorderColor
			    "vs poprz. miesiac",                                                                    -- 10. _Sub1LabelTxt
			    _sub1Val,                                                                               -- 11. _Sub1ValueTxt
			    _sub1Color,                                                                             -- 12. _Sub1ColorTxt
			    "Najwiekszy wzrost:",                                                                   -- 13. _Sub2LabelTxt
			    _sub2Val,                                                                               -- 14. _Sub2ValueTxt
			    "#6A1B9A"                                                                               -- 15. _Sub2ColorTxt
			)
		lineageTag: b17e4cf9-90b7-4681-8a25-07ceb6c371ff

	measure 'KPI Card Product Cost Overall IMG 2' =
			
			// ── Sub1: zmiana vs poprzedni miesiąc ─────────────────────────────────────
			VAR _prev      = 5656
			VAR _momRaw    = 65676
			VAR _hasMoM    = NOT ISBLANK(_prev) && _prev <> 0
			VAR _momArrow  = IF(_momRaw >= 0, "▲ +", "▼ ")
			VAR _sub1Val   = IF(_hasMoM, _momArrow & FORMAT(ABS(_momRaw) * 100, "0.0") & "%", "—")
			VAR _sub1Color = IF(_momRaw >= 0, "#E74C3C", "#27AE60")
			
			// ── Sub2: produkt z największym wzrostem kosztu ────────────────────────────
			VAR _produkty  = VALUES(DimRep[RepName])
			VAR _zDiff     =
			    ADDCOLUMNS(
			        _produkty,
			        "@diff", CALCULATE(500),
			        "@prev", CALCULATE(800)
			    )
			VAR _top1      = TOPN(1, FILTER(_zDiff, [@diff] > 0), [@diff], DESC)
			VAR _topName   = "caldera"
			VAR _topDiff   = "diff"
			VAR _topPrev   = "what what"
