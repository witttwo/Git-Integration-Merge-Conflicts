	measure 'AOV vs Peer Text' =
			
			VAR _p = DIVIDE([AOV] - [Peer Avg AOV], [Peer Avg AOV])
			VAR _i = IF(_p >= 0, "▲ +", "▼ -")
			RETURN IF(ISBLANK(_p), "", _i & FORMAT(ABS(_p), "0%") & " vs peer avg " & FORMAT([Peer Avg AOV], "$#,0"))
		formatString: General
		displayFolder: _Measures\Customer
		lineageTag: 83b82a1c-21e4-461d-807f-bbb9f33c8016

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders LTM' = VAR _anchor = CALCULATE(MAX(FactSales[OrderDate]), ALL(FactSales), ALL(DimDate), ALL(DimDealer), ALL(DimSku), ALL(DimRep)) RETURN CALCULATE([# Orders], DATESINPERIOD(DimDate[Date], _anchor, -12, MONTH))
		formatString: #,0
		displayFolder: _Measures\Customer
		lineageTag: e57cc66d-860e-485f-a4d2-9f279f6a0899

		changedProperty = IsHidden

	measure 'Peer Avg Orders LTM' = VAR _r = SELECTEDVALUE(DimDealer[Region]) VAR _ti = SELECTEDVALUE(DimDealer[Tier]) VAR _peers = FILTER(ALL(DimDealer), DimDealer[Region] = _r && DimDealer[Tier] = _ti) RETURN AVERAGEX(_peers, CALCULATE([Orders LTM]))
		formatString: #,0
		displayFolder: _Measures\Customer
		lineageTag: 78afad29-400d-4058-973e-dfbc2a666d97

		changedProperty = IsHidden

	measure 'Orders LTM vs Peer Text' = ```
			
