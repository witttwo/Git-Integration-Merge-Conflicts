	measure 'Top Dealer Brand Mix' =
			VAR _td = TOPN(1, ALL(DimDealer), [Net Sales], DESC)
			VAR _bs = CALCULATETABLE(ADDCOLUMNS(VALUES(DimSku[Brand]), "@s", CALCULATE([Net Sales])), _td)
			VAR _tb = TOPN(1, _bs, [@s], DESC)
			VAR _n = MAXX(_tb, DimSku[Brand])
			VAR _sh = DIVIDE(SUMX(_tb, [@s]), CALCULATE([Net Sales], _td))
			RETURN _n & " " & FORMAT(_sh, "0%")
		formatString: General
