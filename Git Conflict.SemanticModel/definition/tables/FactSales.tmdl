	measure 'Territory Sales Saturation' =
			
			VAR _sales = [Net Sales]
			RETURN
			    IF(_sales = 0, -0.1, DIVIDE(_sales, MAXX(ALL(DimDealer[Territory]), [Net Sales])))
		formatString: 0.00
		displayFolder: _Measures\Pages
		lineageTag: 933a0401-2c21-40f8-a326-d69274e48006

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Brand Mix Insight Text Channel' =
			
			VAR _BrandSales =
			    ADDCOLUMNS(
			        VALUES(DimSku[Brand]),
			        "@Sales", CALCULATE([Net Sales], ALL(DimDealer)),
			        "@GP", CALCULATE([GP %], ALL(DimDealer))
			    )
			VAR _BrandRank =
			    ADDCOLUMNS(
			        _BrandSales,
			        "@Rank", RANKX(_BrandSales, [@Sales], , DESC, Dense)
			    )
			VAR _Top = FILTER(_BrandRank, [@Rank] = 1)
			VAR _BestMargin = TOPN(1, _BrandSales, [@GP], DESC)
			VAR _TotalSales = SUMX(_BrandSales, [@Sales])
			VAR _TopBrandName = MAXX(_Top, DimSku[Brand])
			VAR _TopShare = DIVIDE(SUMX(_Top, [@Sales]), _TotalSales)
			VAR _TopGP = MAXX(_Top, [@GP])
			VAR _BestMarginName = MAXX(_BestMargin, DimSku[Brand])
			VAR _BestMarginGP = MAXX(_BestMargin, [@GP])
			RETURN
			    _TopBrandName & " represents " & FORMAT(_TopShare, "0%") & " of channel revenue with " & FORMAT(_TopGP, "0.0%") & " margin. Top margin brand: " & _BestMarginName & " at " & FORMAT(_BestMarginGP, "0.0%") & "."
		formatString: General
		displayFolder: _Measures\Pages
		lineageTag: f5ec7e7c-16e2-4129-853a-6243053460e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Tenure' = VAR _t = SELECTEDVALUE(DimDealer[Tenure]) RETURN IF(ISBLANK(_t), "—", FORMAT(_t, "0.0") & " Years")
