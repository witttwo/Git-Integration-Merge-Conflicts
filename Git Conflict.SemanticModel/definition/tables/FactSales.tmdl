	measure 'Net Sales vs Peer %' =
			VAR _Dealer = [Net Sales]
			VAR _Peer = [Peer Benchmark Avg]
			VAR _Result = DIVIDE(_Dealer - _Peer, _Peer)
			RETURN _Result
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: _Measures\Pages
		lineageTag: d4e6f8a0-b2c4-4d6e-9f8a-0b2c4d6e8f0a

