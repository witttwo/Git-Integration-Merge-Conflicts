			VAR _code = SWITCH(
			    _territory,
			    "Alabama", "AL",
			    "Arizona", "AZ",
			    "California", "CA",
			    "Florida", "FL",
			    "Georgia", "GA",
			    "Idaho", "ID",
			    "Kentucky", "KY",
			    "Mississippi", "MS",
			    "Montana", "MT",
			    "Nevada", "NV",
			    "New Mexico", "NM",
			    "North Carolina", "NC",
			    "Oregon", "OR",
			    "South Carolina", "SC",
			    "Tennessee", "TN",
			    "Texas", "TX",
			    "Utah", "UT",
			    "Virginia", "VA",
			    "Washington", "WA",
			    "Wyoming", "WY",
			    ""
			)
			RETURN
			    _code & " " & FORMAT(DIVIDE([Net Sales], 1000000), "$0.0M")
