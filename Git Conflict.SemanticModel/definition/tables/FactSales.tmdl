	measure 'Recency Days' =
			VAR _LastOrder = MAX(FactSales[OrderDate])
			VAR _AsOf = CALCULATE(MAX(FactSales[OrderDate]), ALL(FactSales), ALL(DimDealer), ALL(DimSku), ALL(DimRep))
			VAR _Result = DATEDIFF(_LastOrder, _AsOf, DAY)
			RETURN _Result
		formatString: #,0
		displayFolder: _Measures\Customer
		lineageTag: 10d9e38f-4f3c-4624-98c2-5bf54066b7db

		changedProperty = IsHidden

	measure Frequency =
			VAR _Orders = [# Orders]
