	measure 'Peer Benchmark Avg' =
			VAR _Region = SELECTEDVALUE(DimDealer[Region])
			VAR _Tier = SELECTEDVALUE(DimDealer[Tier])
			VAR _Peers =
				FILTER(
					ALL(DimDealer),
					DimDealer[Region] = _Region
						&& DimDealer[Tier] = _Tier
				)
			VAR _Result = AVERAGEX(_Peers, CALCULATE([Net Sales]))
			RETURN _Result
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: _Measures\Pages
		lineageTag: e74d9b51-ffbd-4504-b8fe-08e1ea3410e2

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Trending Products Last Quarter' =
			VAR _Anchor =
			    CALCULATE(
			        MAX(FactSales[OrderDate]),
			        ALL(FactSales), ALL(DimDate), ALL(DimDealer), ALL(DimSku), ALL(DimRep)
			    )
			VAR _PriorAnchor = EDATE(_Anchor, -3)
			VAR _PriorYear = YEAR(_PriorAnchor)
			VAR _PriorQuarter = QUARTER(_PriorAnchor)
			VAR _PerSku =
			    ADDCOLUMNS(
			        VALUES(DimSku[SkuName]),
			        "@Sales",
			        CALCULATE(
			            [Net Sales],
			            FILTER(
			                ALL(DimDate),
			                YEAR(DimDate[Date]) = _PriorYear
			                    && QUARTER(DimDate[Date]) = _PriorQuarter
			            )
			        )
			    )
			VAR _Top5 = TOPN(5, _PerSku, [@Sales], DESC)
			VAR _Result = CONCATENATEX(_Top5, DimSku[SkuName], ", ", [@Sales], DESC)
			RETURN _Result
		formatString: General
		displayFolder: _Measures\Pages
		lineageTag: e6a508e4-5f00-4b9f-9b9d-289d959bb93a

		changedProperty = IsHidden

	measure 'Dealer Pareto Cumulative %' =
			VAR _CurrentSales = [Net Sales]
			VAR _AllDealers =
				CALCULATETABLE(
					ADDCOLUMNS(
						VALUES(DimDealer[DealerKey]),
						"@Sales", CALCULATE([Net Sales])
					),
					ALL(DimDealer)
				)
			VAR _Total = SUMX(_AllDealers, [@Sales])
			VAR _CumulativeSales =
				SUMX(
					FILTER(_AllDealers, [@Sales] >= _CurrentSales),
					[@Sales]
				)
			VAR _Result = DIVIDE(_CumulativeSales, _Total)
			RETURN _Result
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: _Measures\Pages
		lineageTag: a02ed417-d3f1-4660-a251-8f833d7b92d6

		changedProperty = IsHidden

	measure 'Top 10 Dealer Rank' =
			VAR _CurrentSales = [Net Sales]
			VAR _AllDealers =
				CALCULATETABLE(
					ADDCOLUMNS(
						VALUES(DimDealer[DealerKey]),
						"@Sales", CALCULATE([Net Sales])
					),
					ALL(DimDealer)
				)
			VAR _Rank = COUNTROWS(FILTER(_AllDealers, [@Sales] > _CurrentSales)) + 1
			VAR _Result = IF(_Rank <= 10, _Rank)
			RETURN _Result
		formatString: #,0
		displayFolder: _Measures\Pages
		lineageTag: 7b6cbeac-23f7-45ba-80b6-47db853013db

		changedProperty = IsHidden

