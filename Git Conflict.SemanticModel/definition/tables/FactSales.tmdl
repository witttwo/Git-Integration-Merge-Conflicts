	measure 'Brand Concentration %' =
			VAR _Total = [Net Sales]
			VAR _BrandSales =
				ADDCOLUMNS(
					VALUES(DimSku[Brand]),
					"@s", CALCULATE([Net Sales])
				)
			VAR _Top = TOPN(1, _BrandSales, [@s], DESC)
			VAR _Result = DIVIDE(SUMX(_Top, [@s]), _Total)
			RETURN _Result
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: _Measures\Pages
		lineageTag: b2c4d6e8-f0a2-4b4c-9d6e-8f0a2b4c6d8e

		changedProperty = IsHidden

	measure 'Dealer Channel Share %' =
			
			VAR _Result =
			    DIVIDE(
			        [Net Sales],
			        CALCULATE([Net Sales], ALL(DimDealer), ALL(DimSku[Brand]))
			    )
			RETURN _Result
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: _Measures\Pages
