	measure 'Selected Dealer Location Display' =
			
			VAR _region = SELECTEDVALUE(DimDealer[Region])
			VAR _territory = SELECTEDVALUE(DimDealer[Territory])
			RETURN
			    IF(
			        ISBLANK(_region) || ISBLANK(_territory),
