	measure 'Peer Median Days Since Order' =
			VAR _Region = SELECTEDVALUE(DimDealer[Region])
			VAR _Tier = SELECTEDVALUE(DimDealer[Tier])
			VAR _Peers =
				FILTER(
					ALL(DimDealer),
					DimDealer[Region] = _Region && DimDealer[Tier] = _Tier
				)
			VAR _Result = MEDIANX(_Peers, CALCULATE([Recency Days]))
			RETURN _Result
		formatString: #,0
		displayFolder: _Measures\Customer
		lineageTag: e5f7a9b1-c3d5-4e7f-9a9b-1c3d5e7f9a1b

		changedProperty = IsHidden

	measure 'Recency Alert Text' =
			VAR _Days = [Recency Days]
			VAR _PeerMed = [Peer Median Days Since Order]
			VAR _Result =
				IF(
					ISBLANK(_Days) || ISBLANK(_PeerMed),
					BLANK(),
					IF(
						_Days > _PeerMed,
						"Recency alert: " & FORMAT(_Days, "0") & " days since last order. Peer median is " & FORMAT(_PeerMed, "0") & "d. Raise in visit.",
						"Within cadence: " & FORMAT(_Days, "0") & " days since last order. Peer median " & FORMAT(_PeerMed, "0") & "d."
					)
				)
			RETURN _Result
		formatString: General
		displayFolder: _Measures\Customer
		lineageTag: f6a8b0c2-d4e6-4f8a-9b0c-2d4e6f8a0b2c

		changedProperty = IsHidden

	measure 'Brand Mix Insight Text' =
			VAR _IsSingleDealer = HASONEVALUE(DimDealer[DealerKey])
			VAR _Scope = IF(_IsSingleDealer, "this account's", "channel")
			VAR _BrandSales =
				ADDCOLUMNS(
					VALUES(DimSku[Brand]),
					"@Sales", CALCULATE([Net Sales]),
					"@GP", CALCULATE([GP %])
				)
			VAR _BrandRank =
				ADDCOLUMNS(
					_BrandSales,
					"@Rank", RANKX(_BrandSales, [@Sales], , DESC, Dense)
				)
			VAR _Top = FILTER(_BrandRank, [@Rank] = 1)
			VAR _Second = FILTER(_BrandRank, [@Rank] = 2)
			VAR _TotalSales = SUMX(_BrandSales, [@Sales])
			VAR _TopBrandName = MAXX(_Top, DimSku[Brand])
			VAR _TopShare = DIVIDE(SUMX(_Top, [@Sales]), _TotalSales)
			VAR _TopGP = MAXX(_Top, [@GP])
			VAR _SecondBrandName = MAXX(_Second, DimSku[Brand])
			VAR _SecondGP = MAXX(_Second, [@GP])
			VAR _Result =
				_TopBrandName & " is " & FORMAT(_TopShare, "0%") & " of " & _Scope & " revenue (GP " & FORMAT(_TopGP, "0.0%") & "). Diversification opportunity: " & _SecondBrandName & " at GP " & FORMAT(_SecondGP, "0.0%") & "."
			RETURN _Result
		formatString: General
		displayFolder: _Measures\Pages
		lineageTag: 07b9c1d3-e5f7-4a9b-9c1d-3e5f7a9b1c3d

		changedProperty = IsHidden

	measure 'Brand Revenue Mix %' = DIVIDE([Net Sales], CALCULATE([Net Sales], ALLSELECTED(DimSku[Brand])))
