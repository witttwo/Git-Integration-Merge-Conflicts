table FactQuota
	lineageTag: 63bd39e2-753c-4456-94f6-4e01dfa9f1c2

	measure 'Quota Attainment %' =
			VAR _Result = DIVIDE([Net Sales], [Quota Total])
			RETURN _Result
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: _Measures\Goals
		lineageTag: 65b102e5-403d-4857-ac5d-4805c624913e

		changedProperty = IsHidden

	measure 'Net Sales vs Quota' =
			VAR _Result = [Net Sales] - [Quota Total]
			RETURN _Result
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: _Measures\Goals
		lineageTag: b17bd63c-8424-451f-a30e-9fdab09ef186

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Quota Total' =
			VAR _Result = SUM(FactQuota[SalesAmountQuota])
			RETURN _Result
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: _Measures\Goals
		lineageTag: 63e55f13-1336-458b-bff2-d0b3901ad9b1

		changedProperty = IsHidden

	measure 'Quota Attainment % (Assigned)' =
			VAR _Sales = CALCULATE([Net Sales],  KEEPFILTERS(DimRep[RepKey] <> -1))
			VAR _Quota = CALCULATE([Quota Total], KEEPFILTERS(DimRep[RepKey] <> -1))
			RETURN DIVIDE(_Sales, _Quota)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: _Measures\Goals
		lineageTag: 1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f

		changedProperty = IsHidden

	measure 'Quota Coverage Text' = VAR _A = FILTER(ALL(DimRep), DimRep[RepKey] <> -1) RETURN FORMAT(DIVIDE(CALCULATE([Net Sales], _A), 1000000), "$0.0M") & " / " & FORMAT(DIVIDE(CALCULATE([Quota Total], _A), 1000000), "$0.0M")
		formatString: General
		displayFolder: _Measures\Goals
		lineageTag: c844bcec-22f6-4cba-81b1-454bc0715455

		changedProperty = IsHidden

	measure 'Quota Monthly' = DIVIDE(CALCULATE([Quota Total], ALLEXCEPT(DimDate, DimDate[Year])), 12)
		formatString: \$#,0
		displayFolder: _Measures\Goals
		lineageTag: 9b903fac-49e8-4296-8036-a7b95b08023a

		changedProperty = IsHidden

	measure 'Quota 100' =
			
			IF([Quota Attainment %],
			1)
		displayFolder: _Measures\Goals
		lineageTag: 3d6a2356-67fe-4766-9808-220a5cafd585

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quota 0 Name' =
			
			IF(
			    [Quota Attainment %],
			    0
			)
		displayFolder: _Measures\Goals
		lineageTag: 808be947-0274-42ed-a43d-e24311dfc856

		annotation PBI_FormatHint = {"isGeneralNumber":true}

