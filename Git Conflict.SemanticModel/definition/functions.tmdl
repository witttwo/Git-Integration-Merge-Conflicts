			VAR _MinVal = MINX(ALLNOBLANKROW(columnRef), columnRef)
			VAR _NonPositiveCount = COUNTAX(ALLNOBLANKROW(columnRef), IF(columnRef <= 0, 1, BLANK()))
			VAR _Passed = _NonPositiveCount = 0
