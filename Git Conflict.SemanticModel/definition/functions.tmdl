/// Retrieves tests filtered by environment. Looks for .{ENV}. or .ANY. in function names.
/// If environment is blank, returns all tests.
/// Supports any custom environment naming convention (DEV, TEST, PROD, UAT, STAGING, etc.)
/// Uses INFO.FUNCTIONS only - compatible with Power Automate REST API.
/// For full metadata including Description and RLS ImpersonatedUserName, use RetrieveTestsByEnvironmentV2.
/// @param {STRING} [environment] - Optional environment filter (DEV, TEST, PROD, etc.). Default is "" (all tests).
function 'PQL.Assert.RetrieveTestsByEnvironment' =
		(environment: STRING = "") =>
		    VAR _EnvUpper = UPPER(environment)
		    RETURN
		        SELECTCOLUMNS(
		            FILTER(
		                INFO.FUNCTIONS("ORIGIN", "2"),
		                (RIGHT([FUNCTION_NAME], 5) = ".Test" || RIGHT([FUNCTION_NAME], 6) = ".Tests")
		                && (
		                    ISBLANK(_EnvUpper) || _EnvUpper = ""
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), "." & _EnvUpper & ".")
		                    || CONTAINSSTRING(UPPER([FUNCTION_NAME]), ".ANY.")
		                )
		            ),
		            "Name", [FUNCTION_NAME]
		        )
	lineageTag: 26db2e09-db27-4864-af04-0e682451ab6f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Retrieves all test functions with full metadata (Description, RLS ImpersonatedUserName, RoleName).
/// Uses INFO.USERDEFINEDFUNCTIONS and INFO.ANNOTATIONS - NOT compatible with Power Automate REST API.
/// Use RetrieveTests for Power Automate compatibility.
function 'PQL.Assert.RetrieveTestsV2' =
		() =>
		    VAR _BaseFunctions =
		        SELECTCOLUMNS(
		            FILTER(
		                INFO.FUNCTIONS("ORIGIN", "2"),
		                OR(RIGHT([FUNCTION_NAME], 5) = ".Test", RIGHT([FUNCTION_NAME], 6) = ".Tests")
		            ),
		            "Name", [FUNCTION_NAME]
		        )
		    RETURN
		        ADDCOLUMNS(
		            _BaseFunctions,
		            "Description",
		            VAR _funcName = [Name]
		            RETURN
		            IFERROR(
		                MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [Description]),
		                BLANK()
		            ),
		            "PQLAssert_ImpersonatedUserName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_ImpersonatedUserName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            ),
		            "PQLAssert_RoleName",
		            VAR _funcName = [Name]
		            VAR _funcID =
		                IFERROR(
		                    MAXX(FILTER(INFO.USERDEFINEDFUNCTIONS(), [Name] = _funcName), [ID]),
		                    BLANK()
		                )
		            RETURN
		            IFERROR(
		                MAXX(
		                    FILTER(
		                        INFO.ANNOTATIONS(),
		                        [Name] = "PQLAssert_RoleName"
		                            && [ObjectID] = _funcID
		                    ),
		                    [Value]
		                ),
		                BLANK()
		            )
		        )
	lineageTag: 909a5f0d-85ff-4af3-a746-7b38d2a2d46e

