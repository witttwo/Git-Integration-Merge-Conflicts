function Deviation_6_Months =
		(
			_value: decimal expr,
			_avgValue: expr
		) =>
		
		VAR _Wizyty  = _value
		    VAR _MaxDate = CALCULATE(
		                       MAX(DimDate[Date]),
		                       ALL(FactSales), ALL(DimDate),
		                       ALL(DimDealer), ALL(DimSku), ALL(DimRep)
		                   )
		    VAR _Period  = DATESINPERIOD(DimDate[Date], _MaxDate, -6, MONTH)
		    VAR _MonthlyData =
		        CALCULATETABLE(
		            ADDCOLUMNS(
		                VALUES(DimDate[MonthYear]),
		                "@SredniaPH", _avgValue
		            ),
		            _Period
		        )
		    VAR _FilteredData = FILTER(_MonthlyData, [@SredniaPH] > 0)
		    VAR _MonthsCount  = COUNTROWS(_FilteredData)
		    VAR _Srednia      = AVERAGEX(_FilteredData, [@SredniaPH])
		    VAR _Odchylenie   = STDEVX.S(_FilteredData, [@SredniaPH])
		    RETURN
		    IF(
		        NOT(ISBLANK(_Wizyty)),
		        IF(
		            _MonthsCount > 1,
		            DIVIDE(_Odchylenie, _Srednia)
		        )
		    )
	lineageTag: 9ca8f348-1a11-4355-8e7c-950ee59ae549

/// Pure-SVG imageUrl version of KPI_Ultimate_TwoSubs. Returns data:image/svg+xml data URI.
function KPI_SVG_TwoSubs = ```
		(
		        _TitleTxt : string expr,
		        _ValueKPI : expr,
		        _SuffixTxt : string expr,
		        _IconPathD : string expr,
		        _BgColor : string expr,
		        _FORMATDark : string expr,
		        _FORMATGrey : string expr,
		        _Accent : string expr,
		        _BorderColor : string expr,
		        _Sub1LabelTxt : string expr,
		        _Sub1ValueTxt : string expr,
		        _Sub1ColorTxt : string expr,
		        _Sub2LabelTxt : string expr,
		        _Sub2ValueTxt : string expr,
		        _Sub2ColorTxt : string expr,
		        _IconBgColor : string expr
		    ) =>
		
		-- 1. KOLORY — raw i pre-encoded (#→%23 dla data URI)
		VAR _bgR  = IF(ISBLANK(_BgColor),     "#FFFFFF", _BgColor)
		VAR _dkR  = IF(ISBLANK(_FORMATDark),    "#0A1E41", _FORMATDark)
		VAR _gyR  = IF(ISBLANK(_FORMATGrey),    "#5F6B7C", _FORMATGrey)
		VAR _acR  = IF(ISBLANK(_Accent),      "#6A1B9A", _Accent)
		VAR _bdR  = IF(ISBLANK(_BorderColor), "#E5E7EB", _BorderColor)
		VAR _c1R  = IF(ISBLANK(_Sub1ColorTxt), _gyR, _Sub1ColorTxt)
		VAR _c2R  = IF(ISBLANK(_Sub2ColorTxt), _gyR, _Sub2ColorTxt)
		VAR _ico  = IF(ISBLANK(_IconPathD),    "M12 12h.01", _IconPathD)
		
		VAR _bg   = SUBSTITUTE(_bgR,  "#", "%23")
		VAR _dk   = SUBSTITUTE(_dkR,  "#", "%23")
		VAR _gy   = SUBSTITUTE(_gyR,  "#", "%23")
		VAR _ac   = SUBSTITUTE(_acR,  "#", "%23")
		VAR _bd   = SUBSTITUTE(_bdR,  "#", "%23")
		VAR _c1   = SUBSTITUTE(_c1R,  "#", "%23")
		VAR _c2   = SUBSTITUTE(_c2R,  "#", "%23")
		VAR _icBg = IF(NOT ISBLANK(_IconBgColor), SUBSTITUTE(_IconBgColor, "#", "%23"), BLANK())
		
		-- 2. WARTOŚCI — pre-encode % żeby nie psuć data URI
		VAR _v1 = SUBSTITUTE(_Sub1ValueTxt, "%", "%25")
		VAR _v2 = SUBSTITUTE(_Sub2ValueTxt, "%", "%25")
		
		-- 3. FORMATOWANIE LICZBY — separator tysiąc = przecinek (US Format)
		VAR _rawV = _ValueKPI
		VAR _absV = ABS(INT(_rawV))
		VAR _gi   = INT(_absV / 1000000000)
		VAR _r1   = _absV - _gi * 1000000000
		VAR _mi   = INT(_r1 / 1000000)
		VAR _r2   = _r1 - _mi * 1000000
		VAR _ti   = INT(_r2 / 1000)
		VAR _ui   = _r2 - _ti * 1000
		VAR _fmt  =
		    SWITCH(TRUE(),
		        _gi > 0, FORMAT(_gi,"0") & "," & FORMAT(_mi,"000") & "," & FORMAT(_ti,"000") & "," & FORMAT(_ui,"000"),
		        _mi > 0, FORMAT(_mi,"0") & "," & FORMAT(_ti,"000") & "," & FORMAT(_ui,"000"),
		        _ti > 0, FORMAT(_ti,"0") & "," & FORMAT(_ui,"000"),
		        FORMAT(_absV,"0")
		    )
		VAR _vd = IF(_rawV < 0, "-" & _fmt, _fmt)
		
		-- 4. ROZMIAR CZCIONKI (powiększone pod UI)
		VAR _fs =
		    SWITCH(TRUE(),
		        _absV >= 1000000, "42",
		        _absV >= 100000,  "46",
		        "46"
		    ) 
		
		-- 5. SUFIKS SPECJALNY — "%" (pasek postępu), "M" (miliony) i "$"
		VAR _isPct   = (_SuffixTxt = "%")
		VAR _isM     = (_SuffixTxt = "M")
		VAR _isDollar = (_SuffixTxt = "$")
		VAR _sfx     = SUBSTITUTE(_SuffixTxt, "%", "%25")
		VAR _pctRaw  = IF(_isPct, MIN(MAX(_rawV / 100, 0), 1), 0)
		VAR _fillPx  = FORMAT(ROUND(_pctRaw * 336, 0), "0")
		VAR _dispVal = IF(_isPct, FORMAT(_rawV, "0.0", "en-US"), IF(_isM, FORMAT(_rawV, "0.0", "en-US"), _vd))
		VAR _fsActual = IF(_isM, "46", _fs)
		VAR _divider = IF(_isPct,
		    "<rect x='22' y='110' width='336' height='8' rx='4' fill='" & _bd & "'/><rect x='22' y='110' width='" & _fillPx & "' height='8' rx='4' fill='" & _ac & "'><animate attributeName='width' from='0' to='" & _fillPx & "' dur='1.2s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.4 0 0.2 1'/></rect>",
		    "<line x1='22' y1='114' x2='358' y2='114' stroke='" & _bd & "' stroke-width='1'/>"
		)
		
		VAR _mainValueBlock =
		    IF(_isDollar,
		        "<tspan font-size='34' font-weight='600'>$ </tspan><tspan font-size='" & _fsActual & "' font-weight='700'>" & _dispVal & "</tspan>",
		        "<tspan font-size='" & _fsActual & "' font-weight='700'>" & _dispVal & "</tspan><tspan font-size='28' font-weight='600' dx='5'>" & _sfx & "</tspan>"
		    )
		
		VAR _circleAttr = IF(ISBLANK(_icBg), "fill='" & _ac & "' fill-opacity='0.08'", "fill='" & _icBg & "'")
		
		RETURN
		"data:image/svg+xml,<svg viewBox='0 0 380 210' xmlns='http://www.w3.org/2000/svg'><defs><clipPath id='cp'><rect x='0' y='0' width='380' height='210' rx='20'/></clipPath></defs><g clip-path='url(%23cp)'><rect x='0' y='0' width='380' height='210' fill='" & _bg & "'/><circle cx='336' cy='52' r='28' " & _circleAttr & "/><g transform='translate(322,38) scale(1.167)'><path d='" & _ico & "' fill='none' stroke='" & _ac & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></g><text x='22' y='38' font-family='Montserrat,Segoe UI,sans-serif' font-size='16' font-weight='500' fill='" & _gy & "'>" & _TitleTxt & "</text><text x='22' y='84' font-family='Montserrat,Segoe UI,sans-serif' fill='" & _dk & "'>" & _mainValueBlock & "</text>" & _divider & "<text x='22' y='156' font-family='Montserrat,Segoe UI,sans-serif' font-size='17'><tspan fill='" & _gy & "'>" & _Sub1LabelTxt & " </tspan><tspan fill='" & _c1 & "' font-weight='700'>" & _v1 & "</tspan></text><text x='22' y='184' font-family='Montserrat,Segoe UI,sans-serif' font-size='17'><tspan fill='" & _gy & "'>" & _Sub2LabelTxt & " </tspan><tspan fill='" & _c2 & "' font-weight='700'>" & _v2 & "</tspan></text></g></svg>"
		```
	lineageTag: eb120174-0578-46a0-bb9d-86d367853b30

function Custom_Gradient_Header_SVG = ```
		(
		    _header : string expr,
		    _headerGradient : string expr,
		    _subtitle : string expr,
		    _iconSVGPath : string expr,
		    _headerSizePx : string expr,
		    _subtitleSizePx : string expr,
		    _headerColor : string expr,
		    _subtitleColor : string expr,
		    _gradientStart : string expr,
		    _gradientEnd : string expr,
		    _iconColor : string expr
		)
		=>
		VAR _hSize = SUBSTITUTE(_headerSizePx, "px", "")
		VAR _sSize = SUBSTITUTE(_subtitleSizePx, "px", "")
		
		VAR _iColor = SUBSTITUTE(_iconColor, "#", "%23")
		VAR _gStart = SUBSTITUTE(_gradientStart, "#", "%23")
		VAR _gEnd = SUBSTITUTE(_gradientEnd, "#", "%23")
		VAR _hc = SUBSTITUTE(_headerColor, "#", "%23")
		VAR _sc = SUBSTITUTE(_subtitleColor, "#", "%23")
		
		VAR _icon1 = SUBSTITUTE(_iconSVGPath, "currentcolor", _iColor)
		VAR _icon2 = SUBSTITUTE(_icon1, "currentColor", _iColor)
		VAR _cleanIcon = SUBSTITUTE(_icon2, "#", "%23")
		
		VAR _split1 = FIND(" ", _subtitle, 55, -1)
		VAR _line1 = IF(_split1 <> -1, LEFT(_subtitle, _split1 - 1), _subtitle)
		VAR _rem1 = IF(_split1 <> -1, MID(_subtitle, _split1 + 1, LEN(_subtitle)), "")
		
		VAR _split2 = FIND(" ", _rem1, 55, -1)
		VAR _line2 = IF(_split2 <> -1, LEFT(_rem1, _split2 - 1), _rem1)
		VAR _line3 = IF(_split2 <> -1, MID(_rem1, _split2 + 1, LEN(_rem1)), "")
		
		VAR _dy = VALUE(_sSize) * 1.3
		VAR _textX = 40
		
		VAR _svg = 
		"<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25'>" &
		    "<defs>" &
		        "<linearGradient id='gradText' x1='" & _textX & "' y1='0' x2='340' y2='0' gradientUnits='userSpaceOnUse'>" &
		            "<stop offset='0' stop-color='" & _gStart & "'/>" &
		            "<stop offset='1' stop-color='" & _gEnd & "'/>" &
		        "</linearGradient>" &
		    "</defs>" &
		    "<g transform='translate(0, 0)'>" & 
		        _cleanIcon & 
		    "</g>" &
		    "<text x='" & _textX & "' y='22' font-family='Segoe UI, Arial, sans-serif' font-size='" & _hSize & "px' font-weight='800' fill='" & _hc & "'>" & 
		        _header & " " & 
		        "<tspan fill='url(%23gradText)'>" & _headerGradient & "</tspan>" &
		    "</text>" &
		    "<text x='" & _textX & "' y='46' font-family='Segoe UI, Arial, sans-serif' font-size='" & _sSize & "px' fill='" & _sc & "'>" & 
		        "<tspan x='" & _textX & "' dy='0'>" & _line1 & "</tspan>" &
		        IF(_line2 <> "", "<tspan x='" & _textX & "' dy='" & _dy & "px'>" & _line2 & "</tspan>", "") &
		        IF(_line3 <> "", "<tspan x='" & _textX & "' dy='" & _dy & "px'>" & _line3 & "</tspan>", "") &
		    "</text>" &
		"</svg>"
		
		RETURN "data:image/svg+xml," & _svg
		
		```
	lineageTag: 21f9b336-c61b-4b93-be4e-2ba84bfbd742

function Custom_Header_Ranking = ```
		(
		    _MainTitle : string expr,
		    _Subtitle : string expr,
		    _IconSVG : string expr,
		    _IconColor : string expr,
		    _IconBg : string expr,
		    _TitleColor : string expr,
		    _SubtitleColor : string expr
		) =>
		
		VAR _titleFontColor = IF(ISBLANK(_TitleColor),"#333333",_TitleColor)
		VAR _subFontColor = IF(ISBLANK(_SubtitleColor),"#666666",_SubtitleColor)
		VAR _iconColorCode =  IF(ISBLANK(_IconColor),"#5D9D9D",_IconColor)
		VAR _IconBGColor = IF(ISBLANK(_IconBg),"#5D9D9D",_iconColorCode & "25")
		VAR _HtmlString = 
		"<!DOCTYPE html>
		<html style='margin:0; padding:0; overflow:hidden;'>
		<head>
		    <style>
		        * {
		            font-family: 'Trebuchet MS', Tahoma, Geneva, Verdana, sans-serif !important;
		        }
		        html, body {
		            margin: 0;
		            padding: 0;
		            height: 100%;
		            width: 100%;
		            overflow: hidden;
		            background-color: transparent;
		        }
		        .main-wrapper {
		            position: relative;
		            width: 100%;
		            height: 100%;
		            padding: 5px;
		            box-sizing: border-box;
		            display: flex;
		            align-items: flex-start;
		        }
		        .icon-container {
		            display: flex;
		            justify-content: center;
		            align-items: center;
		            width: 40px;
		            height: 40px;
		            background-color: " & _IconBGColor & ";
		            border-radius: 8px;
		            margin-right: 15px;
		            margin-top: 2px;
		            color: " & _iconColorCode & ";
		            flex-shrink: 0;
		        }
		        .icon-container svg {
		            width: 24px;
		            height: 24px;
		            stroke: currentColor;
		        }
		        .text-container {
		            display: flex;
		            flex-direction: column;
		            justify-content: flex-start;
		        }
		        .title {
		            font-size: 16px;
		            font-weight: 700;
		            color: "&_titleFontColor&";
		            margin-bottom: 2px;
		            line-height: 1.2;
		        }
		        .subtitle {
		            font-size: 13px;
		            color: "&_subFontColor&";
		            line-height: 1.3;
		        }
		    </style>
		</head>
		<body>
		    <div class='main-wrapper'>
		        <div class='icon-container'>
		            " & _IconSVG & "
		        </div>
		        <div class='text-container'>
		            <div class='title'>" & _MainTitle & "</div>
		            <div class='subtitle'>" & _Subtitle & "</div>
		        </div>
		    </div>
		</body>
		</html>"
		RETURN _HtmlString
		```
	lineageTag: da76a32d-4c25-4cc7-a6c7-02aad52f9118

function SVG_Sales_Vs_Quota = ```
		(   
		    _sales : decimal expr,
		    _quota : decimal expr,
		    _globalMax : decimal expr,
		    _colorSalesParam : string expr, 
		    _colorQuotaParam :string expr,
		    _colorTrackParam : string expr,
		    _textColorParam : string expr
		) =>
		    
		// 1. Definicja kolorów z obsługą BLANK()
		VAR _colorSales = IF(ISBLANK(_colorSalesParam), "#006084", _colorSalesParam) // Ciemnoniebieski z Twoich KPI
		VAR _colorQuota = IF(ISBLANK(_colorQuotaParam), "#D9E1E2", _colorQuotaParam) // Jasnoszary
		VAR _colorTrack = IF(ISBLANK(_colorTrackParam), "#F0F3F5", _colorTrackParam) // Bardzo jasne tło osi
		VAR _textColor  = IF(ISBLANK(_textColorParam), "#333333", _textColorParam)
		
		// Jeśli sprzedaż przekracza cel, nadpisujemy kolor na zielony
		VAR _FinalSalesColor = IF(_sales >= _quota, "#148A5E", _colorSales)
		
		// 2. Wymiary i skalowanie
		VAR _W = 200
		VAR _H = 34
		VAR _Margin = 12 // Margines po bokach, żeby kropki nie ucinały się na krawędziach
		VAR _DrawArea = _W - (2 * _Margin)
		
		// Zabezpieczenie przed dzieleniem przez zero i pustymi celami
		VAR _SafeMax = IF(ISBLANK(_globalMax) || _globalMax = 0, 1, _globalMax)
		VAR _Scale = DIVIDE(_DrawArea, _SafeMax)
		
		// 3. Obliczenie współrzędnych X
		VAR _SalesX = _Margin + (COALESCE(_sales, 0) * _Scale)
		VAR _QuotaX = _Margin + (COALESCE(_quota, 0) * _Scale)
		
		// 4. Etykieta procentowa (% realizacji)
		VAR _PctAttainment = DIVIDE(_sales, _quota)
		VAR _PctText = IF(NOT ISBLANK(_PctAttainment), FORMAT(_PctAttainment, "0%"), "")
		
		// 5. Budowa SVG
		VAR _SVG = 
		"data:image/svg+xml;utf8," &
		"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & _W & " " & _H & "'>" &
		    
		    "<!-- Główna linia tła (Track) -->" &
		    "<line x1='" & _Margin & "' y1='" & (_H/2) & "' x2='" & (_W - _Margin) & "' y2='" & (_H/2) & "' stroke='" & _colorTrack & "' stroke-width='4' stroke-linecap='round' />" &
		    
		    "<!-- Linia łącząca wynik z celem (Gap) -->" &
		    "<line x1='" & _SalesX & "' y1='" & (_H/2) & "' x2='" & _QuotaX & "' y2='" & (_H/2) & "' stroke='#A6B5BE' stroke-width='2' />" &
		    
		    "<!-- Kropka Celu -->" &
		    "<circle cx='" & _QuotaX & "' cy='" & (_H/2) & "' r='5' fill='" & _colorQuota & "' />" &
		    
		    "<!-- Kropka Sprzedaży -->" &
		    "<circle cx='" & _SalesX & "' cy='" & (_H/2) & "' r='7' fill='" & _FinalSalesColor & "' />" &
		    
		    "<!-- Tekst wartości obok kropki sprzedaży -->" &
		    "<text x='" & (_SalesX + 11) & "' y='" & ((_H/2) + 3) & "' font-family='Segoe UI' font-size='9' font-weight='bold' fill='" & _FinalSalesColor & "'>" & _PctText & "</text>" &
		    
		"</svg>"
		
		RETURN 
		    IF(ISBLANK(_quota) && ISBLANK(_sales), BLANK(), _SVG)
		```
	lineageTag: 99907030-a5e8-412b-934a-e798dc857c8a

function SVG_Progress_Bar_With_Text = ```
		(   
		    _sales : decimal expr,
		    _quota : decimal expr,
		    _attainment : decimal expr,
		    _globalMax : decimal expr
		) =>
		    
		// 2. Definicja kolorów
		VAR _colorSales = "#006084" // Ciemnoniebieski główny
		VAR _colorQuota = "#E2E8F0" // Jasnoszary dla tła (celu)
		VAR _colorSuccess = "#148A5E" // Zielony, gdy dowożą cel
		VAR _textColor = "#333333"
		
		// Dynamiczny kolor: jeśli sprzedaż >= cel, pasek i procent robią się zielone
		VAR _FinalSalesColor = IF(_sales >= _quota, _colorSuccess, _colorSales)
		
		// 3. Wymiary obszaru (powiększone proporcje)
		VAR _W = 200
		VAR _H = 50 // Więcej miejsca w pionie dla większej czcionki
		VAR _DrawArea = _W 
		
		// 4. Skalowanie szerokości
		VAR _SafeMax = IF(ISBLANK(_globalMax) || _globalMax = 0, 1, _globalMax)
		VAR _Scale = DIVIDE(_DrawArea, _SafeMax)
		
		VAR _SalesW = COALESCE(_sales, 0) * _Scale
		VAR _QuotaW = COALESCE(_quota, 0) * _Scale
		
		// 5. Formatowanie tekstów 
		VAR _SalesText = IF(NOT ISBLANK(_sales), FORMAT(_sales, "$#,##0"), "")
		VAR _PctText = IF(NOT ISBLANK(_attainment), FORMAT(_attainment, "0.0%"), "")
		
		// 6. Budowa SVG z DUŻYMI elementami
		VAR _SVG = 
		"data:image/svg+xml;utf8," &
		"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & _W & " " & _H & "'>" &
		    
		    "<!-- DUŻY Tekst z lewej: Wartość Sprzedaży -->" &
		    "<text x='0' y='18' font-family='Segoe UI' font-size='16' font-weight='600' fill='" & _textColor & "'>" & _SalesText & "</text>" &
		    
		    "<!-- DUŻY Tekst z prawej: % Realizacji -->" &
		    "<text x='" & _W & "' y='18' font-family='Segoe UI' font-size='16' font-weight='bold' fill='" & _FinalSalesColor & "' text-anchor='end'>" & _PctText & "</text>" &
		
		    "<!-- GRUBY Pasek tła (Cel / Quota) -->" &
		    "<rect x='0' y='28' width='" & _QuotaW & "' height='18' rx='9' fill='" & _colorQuota & "' />" &
		    
		    "<!-- GRUBY Pasek wypełnienia (Sprzedaż) -->" &
		    "<rect x='0' y='28' width='" & _SalesW & "' height='18' rx='9' fill='" & _FinalSalesColor & "' />" &
		    
		"</svg>"
		
		RETURN 
		    IF(ISBLANK(_quota) && ISBLANK(_sales), BLANK(), _SVG)
		```
	lineageTag: b40340eb-8181-45f9-8c94-4ea29b1ad944

function SVG_Progress_Bar_With_Text_Parametrized = ```
		(   
		    _sales : decimal expr,
		    _quota : decimal expr,
		    _attainment : decimal expr,
		    _globalMax : decimal expr,
		    _colorSalesParam : string expr,
		    _colorQuotaParam : string expr,
		    _colorSuccessParam : string expr,
		    _textColorParam : string expr
		) =>
		    
		// 1. Definicja kolorów z obsługą BLANK() (Domyślne kolory dla jasnego tła)
		VAR _colorSales = IF(ISBLANK(_colorSalesParam), "#006084", _colorSalesParam) 
		VAR _colorQuota = IF(ISBLANK(_colorQuotaParam), "#E2E8F0", _colorQuotaParam) 
		VAR _colorSuccess = IF(ISBLANK(_colorSuccessParam), "#148A5E", _colorSuccessParam) 
		VAR _textColor = IF(ISBLANK(_textColorParam), "#333333", _textColorParam)
		
		// Dynamiczny kolor: jeśli sprzedaż >= cel, pasek zmienia się na kolor sukcesu
		VAR _FinalSalesColor = IF(_sales >= _quota, _colorSuccess, _colorSales)
		
		// 2. Wymiary obszaru
		VAR _W = 200
		VAR _H = 50 
		VAR _DrawArea = _W 
		
		// 3. Skalowanie szerokości
		VAR _SafeMax = IF(ISBLANK(_globalMax) || _globalMax = 0, 1, _globalMax)
		VAR _Scale = DIVIDE(_DrawArea, _SafeMax)
		
		VAR _SalesW = COALESCE(_sales, 0) * _Scale
		VAR _QuotaW = COALESCE(_quota, 0) * _Scale
		
		// 4. Formatowanie tekstów 
		VAR _SalesText = IF(NOT ISBLANK(_sales), FORMAT(_sales, "$#,##0"), "")
		VAR _PctText = IF(NOT ISBLANK(_attainment), FORMAT(_attainment, "0.0%"), "")
		
		// 5. Budowa SVG z DUŻYMI elementami
		VAR _SVG = 
		"data:image/svg+xml;utf8," &
		"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & _W & " " & _H & "'>" &
		    
		    "<!-- Tekst z lewej -->" &
		    "<text x='0' y='18' font-family='Segoe UI' font-size='18' font-weight='600' fill='" & _textColor & "'>" & _SalesText & "</text>" &
		    
		    "<!-- Tekst z prawej -->" &
		    "<text x='" & _W & "' y='18' font-family='Segoe UI' font-size='18' font-weight='bold' fill='" & _FinalSalesColor & "' text-anchor='end'>" & _PctText & "</text>" &
		
		    "<!-- Pasek tła (Cel / Quota) -->" &
		    "<rect x='0' y='28' width='" & _QuotaW & "' height='18' rx='9' fill='" & _colorQuota & "' />" &
		    
		    "<!-- Pasek wypełnienia (Sprzedaż) -->" &
		    "<rect x='0' y='28' width='" & _SalesW & "' height='18' rx='9' fill='" & _FinalSalesColor & "' />" &
		    
		"</svg>"
		
		RETURN 
