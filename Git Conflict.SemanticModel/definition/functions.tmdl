/// Perspective Assertions - PQL.Assert.Perspective namespace
/// These functions validate perspective configurations and membership in semantic models
/// Asserts that a perspective exists and contains expected tables, columns, and measures.
/// Uses INFO.PERSPECTIVES() and related DMV functions to validate perspective membership.
/// Model-independent: accepts comma-separated string lists instead of TABLE parameters.
/// NOTE: List items should not contain commas. Use exact names without extra delimiters.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} perspectiveName - Name of the perspective to validate
/// @param {STRING} expectedTablesList - Comma-separated table names (empty string for no tables)
/// @param {STRING} expectedColumnsList - Comma-separated column references in Table[Column] format (empty string for no columns)
/// @param {STRING} expectedMeasuresList - Comma-separated measure references in Table[Measure] format (empty string for no measures)
function 'PQL.Assert.Perspective.ShouldContain' =
		(testName: STRING, perspectiveName: STRING, expectedTablesList: STRING, expectedColumnsList: STRING, expectedMeasuresList: STRING) =>
		    VAR _Perspective =
		        FILTER(
		            INFO.PERSPECTIVES(),
		            [Name] = perspectiveName
		        )
		    VAR _PerspectiveExists = COUNTROWS(_Perspective) > 0
		    VAR _PerspectiveID = MAXX(_Perspective, [ID])
		    VAR _PerspectiveTables =
		        FILTER(
		            INFO.PERSPECTIVETABLES(),
		            [PerspectiveID] = _PerspectiveID
		        )
		
		    // Get actual tables in perspective
		    VAR _ActualTables =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                SELECTCOLUMNS(
		                    _PerspectiveTables,
		                    "TableID", [TableID]
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "TableID", [ID],
		                    "Name", [Name]
		                )
		            ),
		            "Name", [Name]
		        )
		
		    // Get actual columns in perspective
		    VAR _ActualColumns =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                NATURALINNERJOIN(
		                    NATURALINNERJOIN(
		                        SELECTCOLUMNS(
		                            INFO.PERSPECTIVECOLUMNS(),
		                            "PerspectiveTableID", [PerspectiveTableID],
		                            "ColumnID", [ColumnID]
		                        ),
		                        SELECTCOLUMNS(
		                            _PerspectiveTables,
		                            "PerspectiveTableID", [ID],
		                            "TableID", [TableID]
		                        )
		                    ),
		                    SELECTCOLUMNS(
		                        INFO.COLUMNS(),
		                        "ColumnID", [ID],
		                        "ColumnName", IF(NOT ISBLANK([ExplicitName]), [ExplicitName], [InferredName])
		                    )
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "TableID", [ID],
		                    "TableName", [Name]
		                )
		            ),
		            "Name", [TableName] & "[" & [ColumnName] & "]"
		        )
		
		    // Get actual measures in perspective
		    VAR _ActualMeasures =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                NATURALINNERJOIN(
		                    NATURALINNERJOIN(
		                        SELECTCOLUMNS(
		                            INFO.PERSPECTIVEMEASURES(),
		                            "PerspectiveTableID", [PerspectiveTableID],
		                            "MeasureID", [MeasureID]
		                        ),
		                        SELECTCOLUMNS(
		                            _PerspectiveTables,
		                            "PerspectiveTableID", [ID]
		                        )
		                    ),
		                    SELECTCOLUMNS(
		                        INFO.MEASURES(),
		                        "MeasureID", [ID],
		                        "MeasureTableID", [TableID],
		                        "MeasureName", [Name]
		                    )
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "MeasureTableID", [ID],
		                    "TableName", [Name]
		                )
		            ),
		            "Name", [TableName] & "[" & [MeasureName] & "]"
		        )
		
		    // Calculate expected counts from comma-separated lists
		    VAR _ExpectedTablesCount =
		        IF(
		            LEN(TRIM(expectedTablesList)) = 0,
		            0,
		            LEN(expectedTablesList) - LEN(SUBSTITUTE(expectedTablesList, ",", "")) + 1
		        )
		    VAR _ExpectedColumnsCount =
		        IF(
		            LEN(TRIM(expectedColumnsList)) = 0,
		            0,
		            LEN(expectedColumnsList) - LEN(SUBSTITUTE(expectedColumnsList, ",", "")) + 1
		        )
		    VAR _ExpectedMeasuresCount =
		        IF(
		            LEN(TRIM(expectedMeasuresList)) = 0,
		            0,
		            LEN(expectedMeasuresList) - LEN(SUBSTITUTE(expectedMeasuresList, ",", "")) + 1
		        )
		
		    // Prepare for case-insensitive string matching with proper delimiters to avoid substring false matches
		    VAR _ExpectedTablesUpper = "," & UPPER(TRIM(expectedTablesList)) & ","
		    VAR _ExpectedColumnsUpper = "," & UPPER(TRIM(expectedColumnsList)) & ","
		    VAR _ExpectedMeasuresUpper = "," & UPPER(TRIM(expectedMeasuresList)) & ","
		
		    // Count matched items using exact string matching (with delimiters to prevent substring matches)
		    VAR _MatchedTablesCount =
		        COUNTROWS(
		            FILTER(
		                _ActualTables,
		                CONTAINSSTRING(_ExpectedTablesUpper, "," & TRIM(UPPER([Name])) & ",")
		            )
		        )
		    VAR _MatchedColumnsCount =
		        COUNTROWS(
		            FILTER(
		                _ActualColumns,
		                CONTAINSSTRING(_ExpectedColumnsUpper, "," & TRIM(UPPER([Name])) & ",")
		            )
		        )
		    VAR _MatchedMeasuresCount =
		        COUNTROWS(
		            FILTER(
		                _ActualMeasures,
		                CONTAINSSTRING(_ExpectedMeasuresUpper, "," & TRIM(UPPER([Name])) & ",")
		            )
		        )
		
		    // Calculate missing counts
		    VAR _MissingTablesCount = MAX(0, _ExpectedTablesCount - _MatchedTablesCount)
		    VAR _MissingColumnsCount = MAX(0, _ExpectedColumnsCount - _MatchedColumnsCount)
		    VAR _MissingMeasuresCount = MAX(0, _ExpectedMeasuresCount - _MatchedMeasuresCount)
		
		    VAR _ExpectedCount = _ExpectedTablesCount + _ExpectedColumnsCount + _ExpectedMeasuresCount
		    VAR _ActualCount = COUNTROWS(_ActualTables) + COUNTROWS(_ActualColumns) + COUNTROWS(_ActualMeasures)
		    VAR _MissingCount = _MissingTablesCount + _MissingColumnsCount + _MissingMeasuresCount
		
		    VAR _Passed = _PerspectiveExists && _MissingCount = 0
		    VAR _Details =
		        IF(
		            NOT _PerspectiveExists,
		            "Perspective not found",
		            IF(
		                _MissingCount > 0,
		                "Missing " & FORMAT(_MissingCount, "0") & " of " & FORMAT(_ExpectedCount, "0") & " expected objects",
		                "All expected objects present"
		            )
		        )
		
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Perspective '" & perspectiveName & "' with " & FORMAT(_ExpectedCount, "0") & " expected objects",
		        "Actual", _Details & " (" & FORMAT(_ActualCount, "0") & " actual objects)",
		        "Passed", _Passed
		    )
	lineageTag: e709b963-c4fa-40cd-90ca-a221223b434b

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a perspective exactly matches expected tables, columns, and measures from comma-separated lists.
/// This is a schema-check style function aligned with other PQL.Assert schema assertions.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} perspectiveName - Name of the perspective to validate
/// @param {STRING} expectedTablesList - Comma-separated table names
/// @param {STRING} expectedColumnsList - Comma-separated column refs in Table[Column] format
/// @param {STRING} expectedMeasuresList - Comma-separated measure refs in Table[Measure] format
function 'PQL.Assert.Perspective.ShouldMatchSchema' =
		(testName: STRING, perspectiveName: STRING, expectedTablesList: STRING, expectedColumnsList: STRING, expectedMeasuresList: STRING) =>
		    VAR _Perspective =
		        FILTER(
		            INFO.PERSPECTIVES(),
		            [Name] = perspectiveName
		        )
		    VAR _PerspectiveExists = COUNTROWS(_Perspective) > 0
		    VAR _PerspectiveID = MAXX(_Perspective, [ID])
		    VAR _PerspectiveTables =
		        FILTER(
		            INFO.PERSPECTIVETABLES(),
		            [PerspectiveID] = _PerspectiveID
		        )
		
		    VAR _ActualTables =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                SELECTCOLUMNS(
		                    _PerspectiveTables,
		                    "TableID", [TableID]
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "TableID", [ID],
		                    "Name", [Name]
		                )
		            ),
		            "Name", [Name]
		        )
		
		    VAR _ActualColumns =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                NATURALINNERJOIN(
		                    NATURALINNERJOIN(
		                        SELECTCOLUMNS(
		                            INFO.PERSPECTIVECOLUMNS(),
		                            "PerspectiveTableID", [PerspectiveTableID],
		                            "ColumnID", [ColumnID]
		                        ),
		                        SELECTCOLUMNS(
		                            _PerspectiveTables,
		                            "PerspectiveTableID", [ID],
		                            "TableID", [TableID]
		                        )
		                    ),
		                    SELECTCOLUMNS(
		                        INFO.COLUMNS(),
		                        "ColumnID", [ID],
		                        "ColumnName", IF(NOT ISBLANK([ExplicitName]), [ExplicitName], [InferredName])
		                    )
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "TableID", [ID],
		                    "TableName", [Name]
		                )
		            ),
		            "Name", [TableName] & "[" & [ColumnName] & "]"
		        )
		
		    VAR _ActualMeasures =
		        SELECTCOLUMNS(
		            NATURALINNERJOIN(
		                NATURALINNERJOIN(
		                    NATURALINNERJOIN(
		                        SELECTCOLUMNS(
		                            INFO.PERSPECTIVEMEASURES(),
		                            "PerspectiveTableID", [PerspectiveTableID],
		                            "MeasureID", [MeasureID]
		                        ),
		                        SELECTCOLUMNS(
		                            _PerspectiveTables,
		                            "PerspectiveTableID", [ID]
		                        )
		                    ),
		                    SELECTCOLUMNS(
		                        INFO.MEASURES(),
		                        "MeasureID", [ID],
		                        "MeasureTableID", [TableID],
		                        "MeasureName", [Name]
		                    )
		                ),
		                SELECTCOLUMNS(
		                    INFO.TABLES(),
		                    "MeasureTableID", [ID],
		                    "TableName", [Name]
		                )
		            ),
		            "Name", [TableName] & "[" & [MeasureName] & "]"
		        )
		
		    VAR _ExpectedTablesCount =
		        IF(
		            LEN(TRIM(expectedTablesList)) = 0,
		            0,
		            LEN(expectedTablesList) - LEN(SUBSTITUTE(expectedTablesList, ",", "")) + 1
		        )
		    VAR _ExpectedColumnsCount =
		        IF(
		            LEN(TRIM(expectedColumnsList)) = 0,
		            0,
		            LEN(expectedColumnsList) - LEN(SUBSTITUTE(expectedColumnsList, ",", "")) + 1
		        )
		    VAR _ExpectedMeasuresCount =
		        IF(
		            LEN(TRIM(expectedMeasuresList)) = 0,
		            0,
		            LEN(expectedMeasuresList) - LEN(SUBSTITUTE(expectedMeasuresList, ",", "")) + 1
		        )
		
		    VAR _ExpectedTablesUpper = "," & UPPER(expectedTablesList) & ","
		    VAR _ExpectedColumnsUpper = "," & UPPER(expectedColumnsList) & ","
		    VAR _ExpectedMeasuresUpper = "," & UPPER(expectedMeasuresList) & ","
		
		    VAR _MatchedTables =
		        FILTER(
		            _ActualTables,
		            CONTAINSSTRING(_ExpectedTablesUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		    VAR _ExtraTables =
		        FILTER(
		            _ActualTables,
		            NOT CONTAINSSTRING(_ExpectedTablesUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		
		    VAR _MatchedColumns =
		        FILTER(
		            _ActualColumns,
		            CONTAINSSTRING(_ExpectedColumnsUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		    VAR _ExtraColumns =
		        FILTER(
		            _ActualColumns,
		            NOT CONTAINSSTRING(_ExpectedColumnsUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		
		    VAR _MatchedMeasures =
		        FILTER(
		            _ActualMeasures,
		            CONTAINSSTRING(_ExpectedMeasuresUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		    VAR _ExtraMeasures =
		        FILTER(
		            _ActualMeasures,
		            NOT CONTAINSSTRING(_ExpectedMeasuresUpper, "," & TRIM(UPPER([Name])) & ",")
		        )
		
		    VAR _MissingTablesCount = COALESCE(MAX(0, _ExpectedTablesCount - COUNTROWS(_MatchedTables)), 0)
		    VAR _MissingColumnsCount = COALESCE(MAX(0, _ExpectedColumnsCount - COUNTROWS(_MatchedColumns)), 0)
		    VAR _MissingMeasuresCount = COALESCE(MAX(0, _ExpectedMeasuresCount - COUNTROWS(_MatchedMeasures)), 0)
		
		    VAR _ExtraTablesCount = COALESCE(COUNTROWS(_ExtraTables), 0)
		    VAR _ExtraColumnsCount = COALESCE(COUNTROWS(_ExtraColumns), 0)
		    VAR _ExtraMeasuresCount = COALESCE(COUNTROWS(_ExtraMeasures), 0)
		
		    VAR _MissingTotal = _MissingTablesCount + _MissingColumnsCount + _MissingMeasuresCount
		    VAR _ExtraTotal = _ExtraTablesCount + _ExtraColumnsCount + _ExtraMeasuresCount
		    VAR _Passed = _PerspectiveExists && _MissingTotal = 0 && _ExtraTotal = 0
		
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Perspective schema exactly matches expected tables/columns/measures",
		        "Actual", IF(
		            NOT _PerspectiveExists,
		            "Perspective not found",
		            "Missing=" & FORMAT(_MissingTotal, "0") & ", Extra=" & FORMAT(_ExtraTotal, "0")
		        ),
		        "Passed", _Passed
		    )
	lineageTag: 033f0db7-ed28-4ba2-b286-eecf577891a8

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a perspective exists in the semantic model.
/// @param {STRING} testName - Description of the test being performed
/// @param {STRING} perspectiveName - Name of the perspective that should exist
function 'PQL.Assert.Perspective.ShouldExist' =
		(testName: STRING, perspectiveName: STRING) =>
		    VAR _Perspective =
		        FILTER(
		            INFO.PERSPECTIVES(),
		            [Name] = perspectiveName
		        )
		    VAR _Exists = COUNTROWS(_Perspective) > 0
		    RETURN ROW(
		        "TestName", testName,
		        "Expected", "Perspective '" & perspectiveName & "' exists",
		        "Actual", IF(_Exists, "EXISTS", "NOT FOUND"),
		        "Passed", _Exists
		    )
	lineageTag: d6e7c88f-0117-425a-9922-109ec9420c46

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Table Assertions - PQL.Assert.Tbl namespace
/// Table-level assertion functions for schema and structure validation
/// Publisher: PQL (Power Query Lint)
/// Asserts that a table has at least one row.
function 'PQL.Assert.Tbl.ShouldHaveRows' =
		(testName : STRING, tableRef : TABLE EXPR) =>
			VAR _RowCount = COUNTROWS(tableRef)
			VAR _Passed = _RowCount > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table has rows",
				"Actual", IF(_Passed, "HAS ROWS (" & FORMAT(_RowCount, "0") & ")", "EMPTY (0 rows)"),
				"Passed", _Passed
			)
	lineageTag: 7be3b00e-936d-4f72-b167-fc213311b0f5

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a table has exactly the expected number of rows.
function 'PQL.Assert.Tbl.ShouldHaveRowCount' =
		(testName : STRING, tableRef : TABLE EXPR, expectedRowCount : INT64) =>
			VAR _RowCount = COUNTROWS(tableRef)
			VAR _Passed = _RowCount = expectedRowCount
			RETURN ROW(
				"TestName", testName,
				"Expected", FORMAT(expectedRowCount, "0") & " rows",
				"Actual", FORMAT(_RowCount, "0") & " rows",
				"Passed", _Passed
			)
	lineageTag: c4cbd518-1b76-4ced-9645-c8b052dec86f

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a table has more rows than the specified threshold.
function 'PQL.Assert.Tbl.ShouldHaveMoreRowsThan' =
		(testName : STRING, threshold : INT64, tableToCheck : TABLE) =>
			VAR _RowCount = COUNTROWS(tableToCheck)
			VAR _Passed = _RowCount > threshold
			RETURN ROW(
				"TestName", testName,
				"Expected", "> " & FORMAT(threshold, "0"),
				"Actual", FORMAT(_RowCount, "0"),
				"Passed", _Passed
			)
	lineageTag: 4e9af649-f3c4-46e2-a87c-533981eb2658

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a table exists in the model.
function 'PQL.Assert.Tbl.ShouldExist' =
		(testName : STRING, tableName : STRING) =>
			VAR _Tables = INFO.VIEW.TABLES()
			VAR _Found = COUNTROWS(FILTER(_Tables, [Name] = tableName)) > 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table '" & tableName & "' exists",
				"Actual", IF(_Found, "EXISTS", "NOT FOUND"),
				"Passed", _Found
			)
	lineageTag: c60745f8-e844-43ae-a3c5-f3064b4d9149

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Schema & Column Shape
/// Asserts that a table has all the specified columns (comma-separated list).
function 'PQL.Assert.Tbl.ShouldHaveColumns' =
		(testName : STRING, tableRef : STRING, columnNamesList : STRING) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _TableColumns = FILTER(_Columns, [Table] = tableRef)
			VAR _ExpectedCount = LEN(columnNamesList) - LEN(SUBSTITUTE(columnNamesList, ",", "")) + 1
			VAR _ColumnNamesUpper = UPPER(columnNamesList)
			VAR _MatchedColumns = FILTER(
				_TableColumns,
				CONTAINSSTRING("," & _ColumnNamesUpper & ",", "," & TRIM(UPPER([Name])) & ",")
			)
			VAR _MatchedCount = COUNTROWS(_MatchedColumns)
			VAR _MissingCount = _ExpectedCount - _MatchedCount
			VAR _ActualColumnNames = CONCATENATEX(_TableColumns, [Name], ", ", [Name], ASC)
			VAR _Passed = _MissingCount <= 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "Table '" & tableRef & "' has columns: " & columnNamesList,
				"Actual", IF(_Passed, "ALL COLUMNS FOUND", "MISSING " & FORMAT(_MissingCount, "0") & " COLUMN(S). Available: " & _ActualColumnNames),
				"Passed", _Passed
			)
	lineageTag: b0d83226-ea9c-47d7-9513-5318e4a33468

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a table does not have extra columns beyond the allowed list (comma-separated).
function 'PQL.Assert.Tbl.ShouldNotHaveExtraColumns' =
		(testName : STRING, tableRef : STRING, allowedColumnNamesList : STRING) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _TableColumns = FILTER(_Columns, [Table] = tableRef && [Type] <> "RowNumber")
			VAR _TableColumnCount = COUNTROWS(_TableColumns)
			VAR _AllowedUpper = UPPER(allowedColumnNamesList)
			VAR _ExtraColumns = FILTER(
				_TableColumns,
				NOT CONTAINSSTRING("," & _AllowedUpper & ",", "," & TRIM(UPPER([Name])) & ",")
			)
			VAR _ExtraCount = COUNTROWS(_ExtraColumns)
			VAR _ExtraList = CONCATENATEX(_ExtraColumns, [Name], ", ", [Name], ASC)
			VAR _Passed = _ExtraCount = 0
			RETURN ROW(
				"TestName", testName,
				"Expected", "No extra columns beyond: " & allowedColumnNamesList,
				"Actual", IF(_Passed, "NO EXTRA COLUMNS (" & FORMAT(_TableColumnCount, "0") & " columns)", "EXTRA COLUMNS FOUND (" & FORMAT(_ExtraCount, "0") & "): " & _ExtraList),
				"Passed", _Passed
			)
	lineageTag: 2de63b9c-acaa-44aa-a2c8-503df6be35fe

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

/// Asserts that a column in a table has the expected data type.
function 'PQL.Assert.Tbl.ColumnDataTypeShouldBe' =
		(testName : STRING, tableRef : STRING, columnName : STRING, expectedType : STRING) =>
			VAR _Columns = INFO.VIEW.COLUMNS()
			VAR _MatchingColumn = FILTER(_Columns, [Table] = tableRef && [Name] = columnName)
			VAR _Found = COUNTROWS(_MatchingColumn) > 0
			VAR _ActualType = IF(_Found, MAXX(_MatchingColumn, [DataType]), "COLUMN NOT FOUND")
			VAR _Passed = _Found && UPPER(_ActualType) = UPPER(expectedType)
			RETURN ROW(
				"TestName", testName,
				"Expected", "Column '" & tableRef & "[" & columnName & "]' data type = " & expectedType,
				"Actual", IF(_Found, "DataType = " & _ActualType, "COLUMN NOT FOUND"),
				"Passed", _Passed
			)
	lineageTag: c98c8fd5-e7c7-4fab-a133-ae8bce3c1897

	annotation DAXLIB_PackageId = PQL.Assert

	annotation DAXLIB_PackageVersion = 0.5.0

